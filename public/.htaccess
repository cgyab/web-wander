# WebWander — Apache config for DreamHost (shared hosting).
# Ships in the build (public/ -> dist/); deploy dist/ to your web directory and
# this file travels with it. All directives are guarded so a missing module is
# harmless rather than a 500.

# ---- MIME types ----------------------------------------------------------
# WASM must be served as application/wasm. The game uses fetch()+arrayBuffer so
# this isn't strictly required today, but it's correct and future-proofs a
# switch to WebAssembly.instantiateStreaming.
<IfModule mod_mime.c>
  AddType application/wasm            .wasm
  AddType application/manifest+json   .webmanifest
  AddType image/svg+xml               .svg
</IfModule>

# ---- Security response headers ------------------------------------------
<IfModule mod_headers.c>
  # Content-Security-Policy as a real response header (stronger than the <meta>
  # in index.html: it applies before the document parses and lets frame-ancestors
  # take effect). Keep this in sync with the <meta>. 'wasm-unsafe-eval' is
  # REQUIRED — without it the WebAssembly module won't compile and the game won't
  # load. The app is fully self-contained, so everything else is 'self'.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  # Clickjacking (belt-and-suspenders with frame-ancestors, for older browsers).
  Header always set X-Frame-Options "DENY"
  # No MIME sniffing — trust the Content-Type above.
  Header always set X-Content-Type-Options "nosniff"
  # Don't leak the URL anywhere (there are no outbound requests anyway).
  Header always set Referrer-Policy "no-referrer"
  # Turn off powerful features the game doesn't use.
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()"
</IfModule>

# ---- Caching -------------------------------------------------------------
# Vite fingerprints everything under /assets/ (content hash in the name), so
# those are safe to cache forever. The entry points below change WITHOUT a new
# filename, so they must revalidate — this is what lets a redeploy actually
# reach a phone or an installed app that visited before.
<IfModule mod_headers.c>
  # Fingerprinted bundles: cache immutably (all .js/.css here are hashed).
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Non-fingerprinted entry points: always revalidate so updates propagate.
  <FilesMatch "^(index\.html|game\.wasm|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Icons change rarely — a short cache is a fine staleness window.
  <FilesMatch "\.(svg|png|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ---- Compression ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript \
    application/json application/manifest+json image/svg+xml application/wasm
</IfModule>

# ---- Default document ----------------------------------------------------
DirectoryIndex index.html
